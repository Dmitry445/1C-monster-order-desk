# 1С OData connection (обязательные)
ODATA_BASE_URL=https://goshift.ru/demo_ut/odata/standard.odata
ODATA_USERNAME=odata.user
ODATA_PASSWORD=replace-with-odata-password

# Таймауты OData (опциональные, в миллисекундах)
ODATA_TIMEOUT=15000
ODATA_CONNECTION_CHECK_TIMEOUT=5000
ODATA_RETRY_DELAY=1000

# Server settings
PORT=3000
NODE_ENV=production

# Client settings (для Vite используйте VITE_ префикс)
VITE_CONNECTION_CHECK_INTERVAL=30000
VITE_TOAST_TIMEOUT=5000

# Разрешённые источники через запятую; пусто для запросов с того же адреса
CORS_ORIGINS=
